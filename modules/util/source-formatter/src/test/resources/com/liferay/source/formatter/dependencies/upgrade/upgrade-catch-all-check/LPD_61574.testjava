package com.liferay.source.formatter.dependencies.upgrade;

import javax.portlet.PortletPreferences;

/**
 * @author Jessyca Ferreira
 */
public class LPD_61574 {

	public void method(PortletPreferences portletPreferences) {
		String preferences = portletPreferences.get(
			0
		).getPreferences();

		preferences.substring(preferences.indexOf("articleId"));
	}

}